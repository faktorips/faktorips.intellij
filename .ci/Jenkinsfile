library 'f10-jenkins-library@1.1_patches'

pipeline {
    agent { label 'linux' }

    tools {
        jdk 'JDK21'
    }

    stages {
        stage('Pre-Build') {
            steps {
                script {
                    currentBuild.displayName = "#${env.BUILD_NUMBER}.${env.GIT_BRANCH}"
                }
            }
        }

        stage('Build and Test') {
            steps {
                withGradle {
                    sh './gradlew clean build printProductsReleases'
                }
            }
        }
    }

    post {
        unsuccessful {
            sendFailureEmail()
        }
    }
}
